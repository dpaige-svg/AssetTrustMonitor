					<ProtectedString name="Source"><![CDATA[local root = script.Parent.Parent

local SecurityLibrary =
	require(
		root.Security["SecurityLibrary"]
	)

local Validator =
	require(
		root.Security[
		"SecurityLibraryValidator"
		]
	)

local ProjectScanner =
	require(
		root.Scanner["ProjectScanner"]
	)

local TestRunner = {}

function TestRunner.Run(testRoot)
	print("==============================")
	print("HE-Utilties v0.3 TEST")
	print("==============================")

	-- Validate security library first.

	local valid, validationErrors =
		Validator.Validate(SecurityLibrary)

	if not valid then
		warn("Security library FAILED validation.")

		for _, message in ipairs(
			validationErrors
			) do
			warn(message)
		end

		return false
	end

	print(
		"Security library:",
		SecurityLibrary.Version
	)

	print("Library validation: PASS")

	-- Run scanner.

	local startedAt = os.clock()

	local findings =
		ProjectScanner.Scan(
			testRoot,
			SecurityLibrary
		)

	local duration =
		os.clock() - startedAt

	print()
	print("Scan complete.")
	print("Findings:", #findings)

	print(
		"Duration:",
		string.format(
			"%.4f seconds",
			duration
		)
	)

	print()

	for _, finding in ipairs(findings) do
		print("------------------------------")
		print("Rule:", finding.RuleId)
		print("Type:", finding.SourceType)
		print("Path:", finding.Path)
		print("Severity:", finding.Severity)
		print("Confidence:", finding.Confidence)
		print("Matched:", finding.MatchedText)
	end

	print("==============================")

	return true, findings
end

return TestRunner]]></ProtectedString>
