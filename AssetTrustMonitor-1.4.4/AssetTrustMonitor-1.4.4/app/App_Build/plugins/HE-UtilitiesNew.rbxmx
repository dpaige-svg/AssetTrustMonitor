				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local HttpService =
	game:GetService("HttpService")

local RemoteLibraryLoader = {}

-- Set this to the production HTTPS endpoint when remote signatures are hosted.
-- An empty value intentionally selects the validated local library without
-- making a network request.
local LIBRARY_URL = ""


function RemoteLibraryLoader.IsConfigured()

	return LIBRARY_URL:match("^https://") ~= nil

end


function RemoteLibraryLoader.Load()

	if not RemoteLibraryLoader.IsConfigured() then

		return false, "Remote security library URL is not configured"

	end

	local success, response =
		pcall(function()

			return HttpService:GetAsync(
				LIBRARY_URL
			)

		end)


	if not success then

		return false, response

	end


	local decodeSuccess, library =
		pcall(function()

			return HttpService:JSONDecode(
				response
			)

		end)


	if not decodeSuccess then

		return false, library

	end


	return true, library

end


return RemoteLibraryLoader]]></ProtectedString>
					<string name="ScriptGuid">{3E486294-90C1-49D2-9659-81D1CAEF0BFE}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">RemoteLibraryLoader</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX794DC8A7C37A4B568247DBFE6DABFE98">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[local root = script.Parent

local SecurityLibrary =
	require(
		root["SecurityLibrary"]
	)

local Validator =
	require(
		root["SecurityLibraryValidator"]
	)

local RemoteLibraryLoader =
	require(
		root["RemoteLibraryLoader"]
	)

local SecurityLibraryProvider = {}


local function validateLibrary(library)

	local valid, errors =
		Validator.Validate(library)

	if valid then
		return true
	end

	return false, errors

end


function SecurityLibraryProvider.GetLibrary()

	-- Try the remote library only when a production HTTPS URL is configured.

	if RemoteLibraryLoader.IsConfigured() then

		local remoteSuccess, remoteLibrary =
			RemoteLibraryLoader.Load()

		if remoteSuccess then

			local valid =
				validateLibrary(
					remoteLibrary
				)

			if valid then

				return remoteLibrary, "Remote"

			end

			warn(
				"[HE-Utilties v0.3] "
					.. "Remote security library "
					.. "failed validation. "
					.. "Using local fallback."
			)

		else

			warn(
				"[HE-Utilties v0.3] "
					.. "Remote security library "
					.. "could not be loaded. "
					.. "Using local fallback."
			)

		end

	end


	-- Remote failed.
	-- Validate our known-good local library.

	local localValid, localErrors =
		validateLibrary(
			SecurityLibrary
		)

	if not localValid then

		warn(
			"[HE-Utilties v0.3] "
				.. "Local fallback library "
				.. "failed validation."
		)

		if localErrors then

			for _, message in ipairs(
				localErrors
				) do
				warn(message)
			end

		end

		return nil, "Unavailable"

	end


	return SecurityLibrary, "LocalFallback"

end


return SecurityLibraryProvider]]></ProtectedString>
