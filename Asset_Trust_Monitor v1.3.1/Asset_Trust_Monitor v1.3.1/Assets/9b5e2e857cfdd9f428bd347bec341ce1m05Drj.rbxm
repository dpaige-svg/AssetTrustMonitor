		<Item class="Script" referent="RBX695">
			<Properties>
				<string name="Name">AnimationLoader</string>
				<ProtectedString name="Source"><![CDATA[--!nonstrict
--[[  ANIMATION LOADER - example  ------------------------------------------------
  After you PUBLISH each KeyframeSequence (see HOW_TO_USE) paste the AnimationIds
  below. Two ways to use them:

  A) ONE-SHOT emotes / actions from anywhere - just call the function below,
     no module to link:
        playAnim(character, "Wave")

  B) REPLACE default movement: copy Idle/Walk/Run/Jump/Fall/Climb/Swim IDs into
     the character's "Animate" script values (Animate.idle.Animation1.AnimationId
     etc.) - those are the built-in movement slots.

  This Script is a template - it plays whatever IDs you fill in. No outside
  services.
------------------------------------------------------------------------------- ]]

local IDS = {
	Idle = "rbxassetid://0",
	Walk = "rbxassetid://0",
	Run = "rbxassetid://0",
	Jump = "rbxassetid://0",
	Fall = "rbxassetid://0",
	Climb = "rbxassetid://0",
	Swim = "rbxassetid://0",
	SwimIdle = "rbxassetid://0",
	Land = "rbxassetid://0",
	Wave = "rbxassetid://0",
	Point = "rbxassetid://0",
	Cheer = "rbxassetid://0",
}

-- Play a one-shot animation on a character. Returns the AnimationTrack.
local function playAnim(character, name)
	local id = IDS[name]
	if not id or id == "rbxassetid://0" then
		warn("AnimationLoader: set the id for " .. tostring(name))
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then return nil end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local track = animator:LoadAnimation(anim)
	track:Play()
	return track
end

-- Example: play the wave on the local player's character (client) or on any
-- character (server). Delete or adapt this line for your game.
_G.playAnim = playAnim

return nil
]]></ProtectedString>
				<bool name="Disabled">false</bool>
			</Properties>
		</Item>
		<Item class="StringValue" referent="RBX696">
			<Properties>
				<string name="Name">HOW_TO_USE</string>
				<string name="Value">R15 COMBAT ANIMATION PACK - 13 animations
CombatIdle, Punch1, Punch2, Uppercut, Kick, SwordSlash1, SwordSlash2,
SwordStab, HeavySlash, Block, HitReact, Defeated, DodgeRoll

WHY YOU PUBLISH THEM YOURSELF: a Roblox animation only plays in a game owned
by the animation's creator, so a pack cannot hand you ready IDs. Instead it
gives you the animation DATA (KeyframeSequences) - you publish each once and
get IDs that work in YOUR game forever.

PUBLISH (one-time, ~1 min each):
1. Drag the 'AnimSaves' folder onto your R15 rig (any R15 Dummy) in Workspace.
2. Select the rig, open Avatar tab -&gt; Animation Editor.
3. In the editor's '...' menu each animation is listed - open one, then
   '...' -&gt; Publish to Roblox. Copy the AnimationId it gives you.
4. Repeat for each animation. (Set the priority: Movement for walk/run,
   Action for emotes - already set on each KeyframeSequence.)

USE THEM: open 'AnimationLoader', paste your IDs into the ID table at the top,
and either call playAnim(character, 'Wave') for one-shots, or follow the
comment to replace the default 'Animate' movement IDs.

No external services and no saved data - just animation clips and one
example Script. Delete this note when you are set up.</string>
			</Properties>
		</Item>
	</Item>
</roblox>